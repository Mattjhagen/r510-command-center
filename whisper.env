# Whisper server environment (sourced by ensure-whisper.sh).
# To pull audio directly from a stream relay instead of browser capture,
# uncomment/EDIT WHISPER_STREAM_URL, then: restart-whisper
# WHISPER_STREAM_URL=http://127.0.0.1:8425/
# Tuning (optional)
# WHISPER_WINDOW=12
# WHISPER_MAX_BYTES=600000
# WHISPER_RMS=0.004