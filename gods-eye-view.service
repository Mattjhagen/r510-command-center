[Unit]
Description=R510 God's Eye View Server
Documentation=https://github.com/bilawalsidhu/gods-eye-view
After=network-online.target
Wants=network-online.target
PartOf=r510-crime-camera.target

[Service]
Type=simple
User=matt
Group=matt
WorkingDirectory=/home/matt/r510-command-center/gods-eye-view
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
Environment="PORT=4173"
Environment="HOST=0.0.0.0"

# Main process - start with environment variables
ExecStart=/bin/bash -c 'PORT=4173 HOST=0.0.0.0 /usr/bin/npm run dev'

# Restart policy
Restart=always
RestartSec=10s
StartLimitInterval=5min
StartLimitBurst=5

# Logging
StandardOutput=append:/var/log/gods-eye-view.log
StandardError=append:/var/log/gods-eye-view.log
SyslogIdentifier=gods-eye-view

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/matt/r510-command-center

# Resource limits
MemoryMax=1G
CPUQuota=100%

[Install]
WantedBy=multi-user.target
WantedBy=r510-crime-camera.target
